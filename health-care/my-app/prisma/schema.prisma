generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

enum AuthRole {
  user
  hospital
  doctor
  blood_bank
}

model AuthAccount {
  id           String   @id @default(cuid())
  role         AuthRole
  name         String
  email        String   @unique
  passwordHash String
  extra        String?
  bloodBank    BloodBank?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model AdminUser {
  id        String   @id
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model User {
  id            String        @id
  email         String        @unique
  name          String?

  appointments  Appointment[]

  createdAt     DateTime      @default(now())
}

model Hospital {
  id                   Int        @id @default(autoincrement())
  name                 String
  username             String?    @unique
  password             String?
  email                String
  city                 String?
  state                String?
  address              String?
  pincode              String?
  phone                String?
  website              String?
  rating               Float      @default(0)
  specialties          String[]   @default([])
  isOpen24Hours        Boolean    @default(false)
  profileCompleted     Boolean    @default(false)
  description          String?
  doctors              Doctor[]
  appointments         Appointment[]
  bloodBank            BloodBank?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @default(now()) @updatedAt
}

model Doctor {
  id            Int      @id @default(autoincrement())
  name          String
  specialty     String   @map("specialization")
  experience    String
  rating        Int
  reviews       Int
  qualification String
  college       String
  tags          String[]
  available     String
  conditions    String[]

  hospitalId    Int
  hospital      Hospital @relation(fields: [hospitalId], references: [id])

  appointments  Appointment[]
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
}

model Appointment {
  id              Int      @id @default(autoincrement())

  user            User     @relation(fields: [userId], references: [id])
  userId          String

  hospital        Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId      Int

  doctor          Doctor   @relation(fields: [doctorId], references: [id])
  doctorId        Int

  name            String
  email           String
  phone           String
  
  appointmentDate DateTime
  appointmentTime String
  problem         String

  status          AppointmentStatus @default(pending)

  createdAt       DateTime @default(now())

  @@unique([doctorId, appointmentDate, appointmentTime])
}


model BloodBank {
  id            Int               @id @default(autoincrement())
  state         String
  district      String
  hospitalName  String
  address       String
  contact       String
  authAccountId String?           @unique
  authAccount   AuthAccount?      @relation(fields: [authAccountId], references: [id], onDelete: SetNull)
  hospitalId    Int?              @unique
  hospital      Hospital?         @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  bloodGroups   BloodInventory[]  // relation
  requests      BloodRequest[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model BloodInventory {
  id            Int       @id @default(autoincrement())
  type          String    // B+, O+, etc.
  available     Boolean
  units         Int
  component     String    // PRBC, Platelets, etc.
  lastUpdated   DateTime

  bloodBankId   Int
  bloodBank     BloodBank @relation(fields: [bloodBankId], references: [id], onDelete: Cascade)
}

enum BloodRequestStatus {
  pending
  approved
  rejected
}

model BloodRequest {
  id             Int                @id @default(autoincrement())
  requesterName  String
  requesterEmail String
  requesterPhone String?
  patientName    String?
  bloodType      String
  component      String
  requestedUnits Int
  message        String?
  status         BloodRequestStatus @default(pending)
  reviewedAt     DateTime?
  bloodBankId    Int
  bloodBank      BloodBank          @relation(fields: [bloodBankId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
}
